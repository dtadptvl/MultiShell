<Window x:Class="MultiShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MultiShell.Models"
        Title="MultiShell"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        StateChanged="OnWindowStateChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="12,12,12,8"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="SHELLS"/>

            <TreeView x:Name="FoldersTree"
                      Grid.Row="1"
                      Margin="6,0,6,6"
                      BorderThickness="0"
                      Background="Transparent"
                      SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:FolderGroupViewModel}"
                                              ItemsSource="{Binding Shells}">
                        <Grid Margin="2,4,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding Folder}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Folder}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="26"
                                    Height="26"
                                    MinHeight="0"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Content="+"
                                    Tag="{Binding Folder}"
                                    ToolTip="Add another CLI to this folder"
                                    Click="OnAddShellToFolderClick"/>
                        </Grid>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type models:ShellItemViewModel}">
                        <Border Padding="4,5,4,5">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open with another shell..."
                                              Click="OnOpenWithAnotherShellClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Width="18"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding StateGlyph}"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding PresetName}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Padding="4,1"
                                        CornerRadius="3"
                                        Background="#E8D9D9"
                                        Visibility="{Binding FullVisibility}">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="FULL"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <Button Grid.Row="2"
                    Margin="8,2,8,10"
                    HorizontalAlignment="Stretch"
                    Content="+ Add Shell"
                    Click="OnAddShellClick"/>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="12,9,10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ShellNameText"
                                   FontWeight="SemiBold"
                                   Text="No shell selected"/>
                        <TextBlock x:Name="FullBadgeText"
                                   Margin="8,0,0,0"
                                   Padding="4,1"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Background="#E8D9D9"
                                   Text="FULL"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="ShellStatusText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Stopped"/>
                        <TextBlock Margin="7,0" Foreground="{StaticResource MutedTextBrush}" Text="·"/>
                        <TextBlock x:Name="ShellFolderText"
                                   MaxWidth="450"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Approval"/>
                    <ComboBox x:Name="ApprovalModeCombo"
                              Width="90"
                              MinHeight="30"
                              Margin="0,0,8,0"
                              SelectionChanged="OnApprovalModeChanged"/>
                    <Button x:Name="OpenFolderButton"
                            Content="Open Folder"
                            Click="OnOpenFolderClick"/>
                    <Button x:Name="StartButton"
                            Content="Start / Resume"
                            Click="OnStartResumeClick"/>
                    <Button x:Name="RestartButton"
                            Content="Restart"
                            Click="OnRestartClick"/>
                    <Button x:Name="StopButton"
                            Content="Stop"
                            Click="OnStopClick"/>
                    <Button x:Name="RemoveButton"
                            Margin="0"
                            Content="Remove"
                            Click="OnRemoveClick"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>

            <Grid Grid.Row="2" Background="#0C0C0C">
                <Grid x:Name="TerminalHostGrid"/>
                <Border x:Name="TerminalPlaceholder" Background="#0C0C0C">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#8A8A8A"
                               Text="Select or start a shell."/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
