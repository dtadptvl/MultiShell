<Window x:Class="MultiShell.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiShell Update"
        Width="430"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Update available"/>
            <TextBlock x:Name="VersionText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Your shell list and preferences are kept."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Later" IsCancel="True"/>
            <Button Margin="0" MinWidth="120" Content="Update &amp; Restart"
                    IsDefault="True" Click="OnUpdateClick"/>
        </StackPanel>
    </Grid>
</Window>
