<Window x:Class="MultiShell.AddShellDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Shell"
        Width="570"
        Height="430"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontWeight="SemiBold" Text="Folder"/>
        <Grid Grid.Row="1" Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderText" MinHeight="30" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseFolderButton" Grid.Column="1" Margin="8,0,0,0"
                    Content="Browse..." Click="OnBrowseFolderClick"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock FontWeight="SemiBold" Text="CLI / shell"/>
                <ComboBox x:Name="PresetCombo" Margin="0,6,0,0" MinHeight="30"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="OnPresetSelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock FontWeight="SemiBold" Text="Approval"/>
                <ComboBox x:Name="ApprovalCombo" Margin="0,6,0,0" MinHeight="30"/>
                <TextBlock x:Name="ApprovalSupportText"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ExecutablePanel" Grid.Row="3" Margin="0,14,0,0">
            <TextBlock FontWeight="SemiBold" Text="Executable"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ExecutableCombo" IsEditable="True" MinHeight="30"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..."
                        Click="OnBrowseExecutableClick"/>
            </Grid>
            <TextBlock x:Name="AvailabilityText" Margin="0,5,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="CustomPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock FontWeight="SemiBold" Text="Custom command"/>
            <TextBox x:Name="CustomCommandText" Margin="0,6,0,0" MinHeight="30"
                     VerticalContentAlignment="Center"/>
            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Run with"/>
            <ComboBox x:Name="CustomHostCombo" Margin="0,6,0,0" MinHeight="30"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Margin="0,14,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="MultiShell remembers these choices for the next Add Shell."
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Margin="0,16,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="AddButton" Margin="0" MinWidth="90"
                    Content="Add" IsDefault="True" Click="OnAddClick"/>
        </StackPanel>
    </Grid>
</Window>
